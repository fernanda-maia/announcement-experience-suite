        <script><![CDATA[(function executeRule(current, previous) {

    var queue = current.queue.getRefRecord();

    if (!queue.isValidRecord())
        return;

    var base = normalize(queue.getValue('name'));

    if (!base)
        base = 'queue';

    var routingKey = base;
    var suffix = 2;

    while (exists(routingKey)) {
        routingKey = base + '_' + suffix;
        suffix++;
    }

    current.setValue('routing_key', routingKey);


    function normalize(value) {
        return (value || '')
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9]+/g, '_')
            .replace(/^_+|_+$/g, '');
    }


    function exists(value) {
        var gr = new GlideRecord('x_733168_aes_agent_chat_queue');

        gr.addQuery('routing_key', value);
        gr.setLimit(1);
        gr.query();

        return gr.hasNext();
    }

})(current, previous);]]></script>
