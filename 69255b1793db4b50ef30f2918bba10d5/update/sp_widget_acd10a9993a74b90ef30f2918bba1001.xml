        <template><![CDATA[<div class="aes-announcement-feed">

  <div class="aes-announcement-list">
    <article class="aes-announcement-card"
             ng-repeat="announcement in data.announcements track by announcement.sys_id">

      <div class="aes-announcement-card__categories"
           ng-if="announcement.categories.length">
        <span ng-repeat="category in announcement.categories">
          {{::category.name}}
        </span>
      </div>

      <h3 class="aes-announcement-card__title">
        {{::announcement.title}}
      </h3>

      <p class="aes-announcement-card__description"
         ng-if="announcement.short_description">
        {{::announcement.short_description}}
      </p>

    </article>
  </div>

  <div class="aes-announcement-feed__empty"
       ng-if="!data.announcements.length">
    No announcements available.
  </div>

</div>]]></template>
    </sp_widget>
</record_update>
