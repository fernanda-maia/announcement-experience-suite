        <name>AES - Announcement Feed</name>
        <option_schema/>
        <public>false</public>
        <roles>x_733168_aes.user</roles>
        <script><![CDATA[(function() {
    var portal = $sp.getPortalRecord();

    var resolver = new AESPortalChannelResolver();
    var channelId = resolver.getChannel(
        portal.getUniqueValue()
    );

    if (!channelId) {
        data.announcements = [];
        return;
    }

    var service = new AESAnnouncementService();

    data.announcements = service.getAvailable({
        displayType: 'feed',
        channel: channelId,
        limit: 12,
        offset: 0
    });

})();]]></script>
        <servicenow>false</servicenow>
        <sys_class_name>sp_widget</sys_class_name>
