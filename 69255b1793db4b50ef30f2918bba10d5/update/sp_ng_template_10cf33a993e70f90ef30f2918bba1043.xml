        <template><![CDATA[<article class="aes-announcement-card aes-announcement-card--grid">
  
  <div class="aes-announcement-card__media">  
    <img ng-if="announcement.image" class="aes-announcement-card__image" ng-src="{{::announcement.image.url}}" alt="{{::announcement.image.alt_text}}">
    <img ng-if="!announcement.image" class="aes-announcement-card__image aes-announcement-card__image--placeholder" src="x_733168_aes.aes-no-image.png" alt="">
    <span class="aes-announcement-card__new" ng-if="announcement.is_new">${New}</span>
  </div>
  
  <div class="aes-announcement-card__body">
    
    <div class="aes-announcement-card__metadata">
     <span class="aes-announcement-card__urgent" ng-if="announcement.urgent">${Urgent}</span>
     <span class="aes-announcement-card__category">
       <span ng-if="announcement.categories.length" ng-attr-title="{{::announcement.categories[0].name}}">{{::announcement.categories[0].name}}</span>
     </span>
    </div>
    
    <h2 class="aes-announcement-card__title" ng-attr-title="{{::announcement.title}}">{{announcement.title}}</h2>
    
    <p class="aes-announcement-card__description">
      <span ng-if="announcement.short_description">{{::announcement.short_description}}</span>
    </p>

    <div class="aes-announcement-card__footer">
      
      <div class="aes-announcement-card__primary-action-slot">
        <a class="aes-announcement-card__primary-action" ng-repeat="action in announcement.actions | filter:{level:'primary'}">
          {{::action.label}}
          <i class="fa fa-arrow-right" aria-hidden="true"></i>
        </a>
      </div>
      
      <div class="aes-announcement-card__footer-meta">
        
        <time class="aes-announcement-card__date">
          <span ng-attr-title="{{::announcement.publish_date_display}}">
            {{::announcement.publish_date_relative}}
          </span>
        </time>
        
        <div class="aes-announcement-card__actions">
          
          <button type="button" class="aes-announcement-card__action"
            ng-disabled="announcement._saving"
            ng-class="{'aes-announcement-card__action--active': announcement.tracking && announcement.tracking.saved}"
            ng-click="c.toggleSaved(announcement, $event)"
            aria-label="{{announcement.tracking && announcement.tracking.saved? '${Remove from saved}' : '${Save announcement}'}}">
            
            <i class="fa" ng-class="announcement.tracking && announcement.tracking.saved? 'fa-bookmark' : 'fa-bookmark-o'" aria-hidden="true"></i>
          </button>
          
          <button type="button" class="aes-announcement-card__action" aria-label="${More actions}">
             <i class="fa fa-plus" aria-hidden="true"></i>
          </button>
        </div>
        
      </div>
    </div>
    
  </div>
</article>]]></template>
    </sp_ng_template>
</record_update>
